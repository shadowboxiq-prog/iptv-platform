# IPTV Management & Streaming Web Platform Environment Configuration

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# 32-byte hexadecimal key for AES-256-GCM secret encryption (source credentials & tokens)
# Generate a random 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=

# Secret key for signing admin JWT sessions
JWT_SECRET=

# Optional extra browser origins. Keep empty for same-origin production use.
APP_ALLOWED_ORIGINS=

# Database path (SQLite)
DATABASE_PATH=./data/iptv.db

# Channel Import Policy: whether newly imported channels are active by default or require review
AUTO_ACTIVATE_IMPORTED=false

# Setup Token: Optional token to allow initial admin setup via web if no admins exist
# Leave blank to enforce CLI creation via: npm run create-admin
SETUP_TOKEN=
